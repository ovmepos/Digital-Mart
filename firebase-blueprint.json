{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the SMM Panel",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User's full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "User's role in the system"
        },
        "walletBalance": {
          "type": "number",
          "description": "User's current wallet balance in OMR"
        },
        "planId": {
          "type": "string",
          "description": "ID of the active subscription plan"
        },
        "planExpiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the subscription plan expires"
        },
        "wishlist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of service IDs in the user's wishlist"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user account was created"
        }
      },
      "required": ["name", "email", "role", "walletBalance", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "An SMM service offered on the platform",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the service (e.g., Instagram Followers)"
        },
        "category": {
          "type": "string",
          "description": "Category of the service (e.g., Instagram, TikTok)"
        },
        "pricePer1000": {
          "type": "number",
          "description": "Price per 1000 units in OMR"
        },
        "minQuantity": {
          "type": "number",
          "description": "Minimum order quantity"
        },
        "maxQuantity": {
          "type": "number",
          "description": "Maximum order quantity"
        },
        "description": {
          "type": "string",
          "description": "Description or details about the service"
        },
        "averageTime": {
          "type": "string",
          "description": "Average time for delivery"
        },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of features"
        },
        "type": {
          "type": "string",
          "description": "Type of the item (e.g., Service, Product)"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the service is currently available for ordering"
        },
        "yoyoServiceId": {
          "type": "string",
          "description": "The service ID on Yoyomedia API"
        },
        "costPrice": {
          "type": "number",
          "description": "The original price from Yoyomedia API"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the service was created"
        }
      },
      "required": ["name", "category", "pricePer1000", "minQuantity", "maxQuantity", "isActive", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user who placed the order"
        },
        "serviceId": {
          "type": "string",
          "description": "ID of the service ordered"
        },
        "serviceName": {
          "type": "string",
          "description": "Name of the service at the time of order"
        },
        "link": {
          "type": "string",
          "description": "Target link for the service (e.g., Instagram profile URL)"
        },
        "quantity": {
          "type": "number",
          "description": "Quantity ordered"
        },
        "totalPrice": {
          "type": "number",
          "description": "Total price charged for the order in OMR"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Processing", "Completed", "Canceled"],
          "description": "Current status of the order"
        },
        "yoyoOrderId": {
          "type": "string",
          "description": "The order ID returned by Yoyomedia API"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the order was placed"
        }
      },
      "required": ["userId", "serviceId", "serviceName", "link", "quantity", "totalPrice", "status", "createdAt"]
    },
    "ApiSettings": {
      "title": "API Settings",
      "description": "Settings for external API integrations",
      "type": "object",
      "properties": {
        "yoyoApiKey": {
          "type": "string",
          "description": "API Key for Yoyomedia"
        },
        "profitMargin": {
          "type": "number",
          "description": "Default profit margin percentage (e.g., 50 for 50%)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["yoyoApiKey", "profitMargin", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A record of a balance change for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user"
        },
        "amount": {
          "type": "number",
          "description": "Amount added or deducted (negative for deduction)"
        },
        "type": {
          "type": "string",
          "enum": ["topup", "order", "refund", "adjustment"],
          "description": "Type of transaction"
        },
        "description": {
          "type": "string",
          "description": "Description of the transaction"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the transaction occurred"
        }
      },
      "required": ["userId", "amount", "type", "description", "createdAt"]
    },
    "ManualTransfer": {
      "title": "Manual Transfer",
      "description": "A record of a manual bank transfer proof",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "proofUrl", "status", "createdAt"]
    },
    "CartItem": {
      "title": "Cart Item",
      "description": "An item in a user's shopping cart",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "quantity": { "type": "number" },
        "link": { "type": "string" },
        "price": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceId", "serviceName", "quantity", "link", "price", "createdAt"]
    },
    "SubscriptionPlan": {
      "title": "Subscription Plan",
      "description": "A subscription plan for discounts",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "price": { "type": "number" },
        "duration": { "type": "string", "enum": ["monthly", "yearly"] },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "discountPercentage", "price", "duration", "isActive", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "A category for services (e.g., Instagram, TikTok)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "isActive", "createdAt"]
    },
    "ServiceType": {
      "title": "Service Type",
      "description": "A type for services (e.g., Followers, Likes)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "isActive", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and wallet balances"
    },
    "/services/{serviceId}": {
      "schema": {
        "$ref": "#/entities/Service"
      },
      "description": "Stores available SMM services"
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Stores user orders"
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Stores user wallet transactions"
    },
    "/manualTransfers/{transferId}": {
      "schema": {
        "$ref": "#/entities/ManualTransfer"
      },
      "description": "Stores manual transfer proofs"
    },
    "/cart/{cartItemId}": {
      "schema": {
        "$ref": "#/entities/CartItem"
      },
      "description": "Stores user cart items"
    },
    "/subscriptionPlans/{planId}": {
      "schema": {
        "$ref": "#/entities/SubscriptionPlan"
      },
      "description": "Stores subscription plans"
    },
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "Stores service categories"
    },
    "/serviceTypes/{typeId}": {
      "schema": {
        "$ref": "#/entities/ServiceType"
      },
      "description": "Stores service types"
    },
    "/apiSettings/{settingsId}": {
      "schema": {
        "$ref": "#/entities/ApiSettings"
      },
      "description": "Stores external API settings"
    }
  }
}
