{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the SMM Panel",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User's full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "User's role in the system"
        },
        "walletBalance": {
          "type": "number",
          "description": "User's current wallet balance in OMR"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user account was created"
        }
      },
      "required": ["name", "email", "role", "walletBalance", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "An SMM service offered on the platform",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the service (e.g., Instagram Followers)"
        },
        "category": {
          "type": "string",
          "description": "Category of the service (e.g., Instagram, TikTok)"
        },
        "pricePer1000": {
          "type": "number",
          "description": "Price per 1000 units in OMR"
        },
        "minQuantity": {
          "type": "number",
          "description": "Minimum order quantity"
        },
        "maxQuantity": {
          "type": "number",
          "description": "Maximum order quantity"
        },
        "description": {
          "type": "string",
          "description": "Description or details about the service"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the service is currently available for ordering"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the service was created"
        }
      },
      "required": ["name", "category", "pricePer1000", "minQuantity", "maxQuantity", "isActive", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user who placed the order"
        },
        "serviceId": {
          "type": "string",
          "description": "ID of the service ordered"
        },
        "serviceName": {
          "type": "string",
          "description": "Name of the service at the time of order"
        },
        "link": {
          "type": "string",
          "description": "Target link for the service (e.g., Instagram profile URL)"
        },
        "quantity": {
          "type": "number",
          "description": "Quantity ordered"
        },
        "totalPrice": {
          "type": "number",
          "description": "Total price charged for the order in OMR"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Processing", "Completed", "Canceled"],
          "description": "Current status of the order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the order was placed"
        }
      },
      "required": ["userId", "serviceId", "serviceName", "link", "quantity", "totalPrice", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and wallet balances"
    },
    "/services/{serviceId}": {
      "schema": {
        "$ref": "#/entities/Service"
      },
      "description": "Stores available SMM services"
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Stores user orders"
    }
  }
}
